<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DecisionTree.Excel</RootNamespace>

    <!-- Excel-DNA -->
    <ExcelAddInName>DecisionTree Studio</ExcelAddInName>
    <ExcelAddInFileName>DecisionTreeStudio</ExcelAddInFileName>
    <ExcelAddIn32BitFileName></ExcelAddIn32BitFileName>
    <RunExcelDnaSetDebuggerOptions>false</RunExcelDnaSetDebuggerOptions>
    <!-- Only methods marked [ExcelCommand]/[ExcelFunction] are registered with Excel. -->
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DecisionTree.Core\DecisionTree.Core.csproj" />
  </ItemGroup>

</Project>
